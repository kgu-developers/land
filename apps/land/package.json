    "react-dom": "catalog:react19"
  },
  "devDependencies": {
    "@aics/typescript": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.1",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "typescript": "^5.8.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.1",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.10"
  }
