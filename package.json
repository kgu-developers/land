{
  "name": "kd-land",
  "private": true,
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @kd/land dev",
    "build": "pnpm --filter @kd/land build",
    "start": "pnpm --filter @kd/land start",
    "lint": "pnpm --filter @kd/land lint",
    "typecheck": "pnpm --filter @kd/land typecheck",
    "test": "pnpm --filter @kd/land test",
    "test:logic": "pnpm --filter @kd/land test:logic",
    "test:ui": "pnpm --filter @kd/land test:ui",
    "test:e2e": "pnpm --filter @kd/land test:e2e",
    "test:e2e:ui": "pnpm --filter @kd/land test:e2e:ui",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "lefthook install",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "lefthook": "^1.11.11"
  }
}
